# --- API CONFIGURATION ---
# अपनी API Keys यहीं डालें (इन्हें कभी भी GitHub पर पुश न करना!)

# 1. Speech-to-Text (STT) - जैसे OpenAI Whisper
OPENAI_API_KEY="sk-your-openai-api-key-here"

# 2. Translation API (अगर कोई एक्सटर्नल सर्विस यूज़ कर रहे हो)
TRANSLATION_API_KEY="your-translation-key-here"

# 3. Text-to-Speech (TTS) & Voice Cloning - जैसे ElevenLabs
ELEVENLABS_API_KEY="your-elevenlabs-key-here"

# --- Server Config ---
PORT=8000
